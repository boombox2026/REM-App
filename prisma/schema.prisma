generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Task {
  id          Int      @id @default(autoincrement())
  text        String   // النص أو التاسك اللي المستخدم قاله
  dueDate     DateTime // الميعاد اللي استخرجناه
  isCompleted Boolean  @default(false) // غيرنا الاسم هنا عشان يطابق كود الواجهة
  createdAt   DateTime @default(now())
}